# Server
PORT=3001

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=autoflex
DATABASE_PASSWORD=autoflex
DATABASE_NAME=autoflex
DATABASE_LOGGING=false

# Test database (e2e)
DATABASE_NAME_TEST=autoflex_test

# Frevels IAM — JWT verification (resource server only)
# Point to IAM JWKS endpoint in dev/staging/prod:
IAM_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWKS_CACHE_TTL_MS=300000

# Customer DomainApplication (CustApp / customer-web). Staff tokens use a different id.
IAM_CUSTOMER_DOMAIN_APPLICATION_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

# Optional JWT claim validation (set when IAM configures iss/aud)
# IAM_JWT_ISSUER=
# IAM_JWT_AUDIENCE=

# Local-only: inline JWKS JSON for tests/offline dev (do not use in production)
# LOCAL_JWKS_JSON={"keys":[{"kty":"RSA","kid":"test-primary",...}]}

# Dev seed defaults (npm run seed:dev)
SEED_IAM_DOMAIN_ID=11111111-1111-4111-8111-111111111111
SEED_IAM_USER_ID=22222222-2222-4222-8222-222222222222
SEED_CENTER_NAME=Demo Service Center
SEED_STAFF_NAME=Demo Advisor
