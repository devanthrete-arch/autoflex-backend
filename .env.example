# Server
PORT=3001

# Customer skip fallback. Bengaluru is the agreed product default.
DISCOVERY_DEFAULT_CITY=Bengaluru
DISCOVERY_DEFAULT_LABEL=Bengaluru

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=autoflex
DATABASE_PASSWORD=autoflex
DATABASE_NAME=autoflex
DATABASE_LOGGING=false

# Test database (e2e)
DATABASE_NAME_TEST=autoflex_test

# Frevels IAM — JWT verification (resource server only)
# Point to IAM JWKS endpoint in dev/staging/prod:
IAM_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWKS_CACHE_TTL_MS=300000

# Customer DomainApplication (CustApp / customer-web). Staff tokens use a different id.
IAM_CUSTOMER_DOMAIN_APPLICATION_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

# Optional JWT claim validation (set when IAM configures iss/aud)
# IAM_JWT_ISSUER=
# IAM_JWT_AUDIENCE=

# Local-only: inline JWKS JSON for tests/offline dev (do not use in production)
# LOCAL_JWKS_JSON={"keys":[{"kty":"RSA","kid":"test-primary",...}]}

# Older IAM-domain mapping (`npm run seed:dev`). The test workshop is
# `npm run start:workshop`, which upserts Apex Auto Garage into this database.
# Dev seed defaults (npm run seed:dev)
SEED_IAM_DOMAIN_ID=11111111-1111-4111-8111-111111111111
SEED_IAM_USER_ID=22222222-2222-4222-8222-222222222222
SEED_CENTER_NAME=Demo Service Center
SEED_STAFF_NAME=Demo Advisor

# Central support application, distinct from customer and center applications.
# Blank values disable support operator access. Provision active profiles separately.
IAM_SUPPORT_DOMAIN_APPLICATION_ID=
IAM_SUPPORT_DOMAIN_ID=

# AF-019: staged invoicing core. Keep false until center finance setup and release gates pass.
BILLING_V2_ENABLED=false
# Dedicated Autoflex finance application/domain. No ordinary staff/support fallback.
IAM_FINANCE_DOMAIN_APPLICATION_ID=
IAM_FINANCE_DOMAIN_ID=

# AF-006 reception handoff. Set a stable random >=32-character secret via secret management.
RECEPTION_CHALLENGE_KEY=
# Proposed verified-phone broker contract; agree its claims with IAM before enabling live use.
RECEPTION_IDENTITY_ISSUER=
RECEPTION_IDENTITY_AUDIENCE=
RECEPTION_IDENTITY_JWKS_URL=
RECEPTION_IDENTITY_BROKER_URL=
RECEPTION_IDENTITY_BROKER_TOKEN=
# Local JWKS accepted outside production only; development entries configure this themselves.
# RECEPTION_IDENTITY_LOCAL_JWKS=

# AF-019 private issued documents. Filesystem is rejected in production.
INVOICE_STORAGE_DRIVER=
INVOICE_S3_BUCKET=
AWS_REGION=
# Use IAM instance/task roles; do not put AWS secrets in source or a browser build.
INVOICE_DOCUMENT_WORKER_ENABLED=false
# Development filesystem only:
# INVOICE_LOCAL_DIRECTORY=.private-invoices

# Internal finance CLI: supply tokens through the normal secret/session channel, never Git.
# AUTOFLEX_API_URL=https://api.example.invalid
# AUTOFLEX_FINANCE_TOKEN=
